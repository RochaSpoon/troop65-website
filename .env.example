# Copy to .env.local for local development. On Vercel, set these under
# Project Settings > Environment Variables. See MAINTAINER.md.

# From sanity.io/manage > your project. Without it the site shows content/seed.json.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Any long random string. Must match the secret on the Sanity webhook.
SANITY_REVALIDATE_SECRET=

# The live address, used for the sitemap and link previews.
NEXT_PUBLIC_SITE_URL=https://t65.org

# Only needed to run `npm run import-content`. An Editor token from sanity.io/manage > API > Tokens.
# Do not add this one to Vercel.
SANITY_API_WRITE_TOKEN=
